# Local docker-compose environment variables for testing
# Set ADDRESS to your LAN IP or localhost
# ! Needs to be the adress the users will access. Else the Webhooks will not work properly.
ADDRESS=https://NBK.mydomain.com

# Administrator password for web UI (used by docker-compose to pass --admin-password)
# Set to blank to allow open admin access (everyone is admin)
ADMIN_PASSWORD="secret123"

# --- Cloudflare Tunnel Settings ---
# Create a tunnel in the Cloudflare Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Cloudflared), point its public
# hostname at http://NBK:5555, and paste the tunnel token below.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token