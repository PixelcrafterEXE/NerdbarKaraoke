# Local docker-compose environment variables for testing
# Set ADDRESS to your LAN IP or localhost
# ! Needs to be the adress the users will access. Else the Webhooks will not work properly.
ADDRESS=http://localhost:5555

# Administrator password for web UI (used by docker-compose to pass --admin-password)
# Set to blank to allow open admin access (everyone is admin)
ADMIN_PASSWORD="secret123"

# Song addition cooldown settings
# SONG_ADD_COOLDOWN_COUNT: Number of songs a user must add before cooldown is triggered
# Set to -1 to disable cooldown (default: -1)
SONG_ADD_COOLDOWN_COUNT=-1

# SONG_ADD_COOLDOWN_DURATION: Cooldown duration in minutes
# A user cannot add any song if they have added SONG_ADD_COOLDOWN_COUNT songs in the last SONG_ADD_COOLDOWN_DURATION minutes
# Set to -1 to disable cooldown (default: -1)
SONG_ADD_COOLDOWN_DURATION=-1

# Message of the day (MOTD) text shown on the splash screen
MOTD="Welcome to nerdBar Karaoke!"